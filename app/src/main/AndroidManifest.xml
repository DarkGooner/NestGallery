<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Face scanning keeps running while the app is minimised: foreground service + CPU wake lock + progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.NestGallery"
        android:supportsRtl="true">
        <!-- Android 12+ only lets apps load vendor libraries they declare. NSFW scan on the Snapdragon NPU needs the
             FastRPC channel to the Hexagon DSP (QNN HTP), on the GPU it needs OpenCL (QNN GPU). Optional: without
             them the scan uses the CPU. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NestGallery"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.face.FaceScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".data.nsfw.NsfwScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
